<%- include('../partials/head', { pageTitle: 'Teacher Dashboard', active: 'dashboard' }) %>
<%- include('../partials/header', { user: user, active: active }) %>
<div class="page-head">
  <div class="page-head-icon" style="background:linear-gradient(135deg,#0891b2,#22d3ee)"><i class="bi bi-person-badge"></i></div>
  <div>
    <h1 class="page-head-title">Welcome, <%= teacher ? teacher.fullName : user.username %></h1>
    <p class="page-head-sub">Here's what you can do today</p>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <div class="stat-icon text-primary"><i class="bi bi-book"></i></div>
      <div><div class="stat-value"><%= subjectCount %></div><div class="stat-label">Subjects Assigned</div></div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <div class="stat-icon" style="color:#16a34a;background:rgba(22,163,74,.12)"><i class="bi bi-clipboard-check"></i></div>
      <div><div class="stat-value">Today</div><div class="stat-label">To record attendance</div></div>
    </div></div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card h-100"><div class="card-header">
        <span class="header-title"><i class="bi bi-lightning-charge me-2 text-primary"></i>Quick Actions</span>
      </div>
      <div class="card-body d-grid gap-2">
        <a class="quick-action" href="/attendance"><div class="d-flex align-items-center gap-3"><div class="qa-icon"><i class="bi bi-calendar-check"></i></div><div><div class="qa-title">Mark Today's Attendance</div><div class="qa-sub">Pick class & section</div></div></div></a>
        <a class="quick-action" href="/marks"><div class="d-flex align-items-center gap-3"><div class="qa-icon"><i class="bi bi-pencil-square"></i></div><div><div class="qa-title">Enter Marks</div><div class="qa-sub">Fill exam results per student</div></div></div></a>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card h-100"><div class="card-header">
        <span class="header-title"><i class="bi bi-journal-text me-2 text-primary"></i>My Subjects</span>
        <span class="badge text-bg-primary ms-auto"><%= subjectCount %></span>
      </div>
      <div class="card-body">
        <% var mySubjects = (subjects || []).filter(function (s) { return teacher && Number(s.teacherId) === Number(teacher.teacherId); }); %>
        <% if (!mySubjects.length) { %>
          <div class="empty-state"><i class="bi bi-journal-x empty-icon"></i><div class="empty-title">No subjects assigned</div><div class="empty-sub">Ask an admin to assign you subjects.</div></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Subject</th><th class="text-end">Class</th></tr></thead>
            <tbody><% mySubjects.forEach(function (s) { %><tr><td class="fw-semibold"><i class="bi bi-book me-2 text-muted"></i><%= s.subjectName %></td><td class="text-end"><span class="badge text-bg-light border"><%= s.className %></span></td></tr><% }) %></tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>