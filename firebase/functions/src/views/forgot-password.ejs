<%- include('partials/head', { pageTitle: 'Forgot Password', active: '' }) %>
  <section class="auth-split">
    <div class="auth-brand">
      <div class="auth-blob blob-1"></div>
      <div class="auth-blob blob-2"></div>
      <div class="auth-blob blob-3"></div>
      <div class="auth-brand-top">
        <div class="auth-brand-logo"><i class="bi bi-mortarboard-fill"></i></div>
        <span class="auth-brand-name">SM</span>
      </div>
      <div class="auth-brand-body">
        <h1>Run your school,<br>beautifully.</h1>
        <p>Students, teachers, marks, fees, attendance and transport — everything in one modern workspace.</p>
        <ul class="auth-features">
          <li><span class="fi"><i class="bi bi-clipboard-check"></i></span> Live report cards &amp; exam analysis</li>
          <li><span class="fi"><i class="bi bi-calendar-check"></i></span> Attendance &amp; fee tracking</li>
          <li><span class="fi"><i class="bi bi-chat-dots"></i></span> Parent–teacher messaging</li>
        </ul>
      </div>
      <div class="auth-brand-stats">
        <div class="st"><b>1200+</b><span>Students</span></div>
        <div class="st"><b>98.4%</b><span>Attendance</span></div>
        <div class="st"><b>A+</b><span>Top grade</span></div>
      </div>
      <div class="auth-brand-foot">&copy; 2026 SM System</div>
    </div>
    <div class="auth-form">
      <div class="auth-card-new">
        <div class="text-center">
          <div class="auth-icon mx-auto"><i class="bi bi-shield-lock"></i></div>
          <h2>Reset password</h2>
          <p class="sub">Enter your username or email to set a new password</p>
        </div>
        <form method="post" action="/forgot-password">
          <div class="mb-3 auth-input-group">
            <i class="bi bi-person input-icon"></i>
            <input class="form-control" name="username" placeholder="Username or email" required autofocus>
          </div>
          <div class="mb-3 auth-input-group">
            <i class="bi bi-lock input-icon"></i>
            <input type="password" class="form-control" name="password" placeholder="New password (min 6)" required>
          </div>
          <div class="mb-4 auth-input-group">
            <i class="bi bi-lock-fill input-icon"></i>
            <input type="password" class="form-control" name="confirmPassword" placeholder="Confirm new password" required>
          </div>
          <button class="btn auth-submit" type="submit"><i class="bi bi-arrow-repeat me-2"></i>Reset Password</button>
        </form>
        <div class="d-flex align-items-center justify-content-between mt-4">
          <a class="auth-link" href="/login">Back to Sign in</a>
          <a class="auth-link" href="/forgot-username">Forgot username?</a>
        </div>
      </div>
    </div>
  </section>
</main></div></div>
<%- include('partials/footer') %>