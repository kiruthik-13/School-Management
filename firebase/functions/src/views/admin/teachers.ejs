<%- include('../partials/head', { pageTitle: 'Teachers', active: 'teachers' }) %>
<%- include('../partials/header', { user: user, active: active }) %>
<div class="page-head">
  <div class="page-head-icon" style="background:linear-gradient(135deg,#0891b2,#22d3ee)"><i class="bi bi-person-video3"></i></div>
  <div>
    <h1 class="page-head-title">Teachers</h1>
    <p class="page-head-sub">Staff profiles and login accounts</p>
  </div>
  <div class="page-head-actions">
    <a href="/teacher/edit" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Add Teacher</a>
  </div>
</div>

<div class="card shadow-sm mb-4"><div class="card-body">
  <div class="toolbar">
    <div class="search-box">
      <i class="bi bi-search"></i>
      <input type="text" class="form-control" data-table-filter="#teachersTable" placeholder="Search name, subject, phone..." aria-label="Search teachers">
    </div>
  </div>
</div></div>

<div class="card shadow-sm table-card"><div class="card-body p-0">
  <% if (!teachers || !teachers.length) { %>
    <div class="empty-state"><i class="bi bi-inbox empty-icon"></i><div class="empty-title">No teachers yet</div><div class="empty-sub">Add a teacher to create their login account.</div></div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="teachersTable">
      <thead><tr><th>Name</th><th>Specialization</th><th>Phone</th><th>Login</th><th class="text-end">Actions</th></tr></thead>
      <tbody><% (teachers || []).forEach(function (t) { %><tr>
        <td class="fw-semibold"><span class="avatar-inline"><i class="bi bi-person-video3"></i></span><%= t.fullName %></td>
        <td><%= t.subjectSpecialization || '<span class="text-muted">—</span>' %></td>
        <td><%= t.phone || '-' %></td>
        <td><code><%= t.username || '-' %></code></td>
        <td class="text-end"><div class="btn-group btn-group-sm">
          <a class="btn btn-outline-primary" href="/teacher/edit?id=<%= t.teacherId %>"><i class="bi bi-pencil"></i> Edit</a>
          <a class="btn btn-outline-danger" href="/teacher/delete?id=<%= t.teacherId %>" data-confirm="Delete <%= t.fullName %> and their login account?"><i class="bi bi-trash"></i></a>
        </div></td>
      </tr><% }) %></tbody>
    </table>
  </div>
  <% } %>
</div></div>
<%- include('../partials/footer') %>