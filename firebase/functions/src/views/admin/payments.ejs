<%- include('../partials/head', { pageTitle: 'Fee Payments', active: 'fees' }) %>
<%- include('../partials/header', { user: user, active: active }) %>
<div class="page-head">
  <div class="page-head-icon" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-receipt-cutoff"></i></div>
  <div>
    <h1 class="page-head-title">Fee Payments</h1>
    <p class="page-head-sub">Record receipts and review collections</p>
  </div>
  <div class="page-head-actions">
    <a class="btn btn-outline-secondary" href="/fees"><i class="bi bi-cash-stack me-1"></i> Fee Structures</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-5"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
    <div class="stat-icon" style="color:#16a34a;background:rgba(22,163,74,.12)"><i class="bi bi-currency-rupee"></i></div>
    <div><div class="stat-value">Rs <%= Number(summary ? summary.totalCollected : 0).toLocaleString() %></div><div class="stat-label">Total Collected</div></div>
  </div></div></div>
  <div class="col-md-7"><div class="card stat-card h-100"><div class="card-body">
    <div class="table-responsive"><table class="table table-sm mb-0 align-middle">
      <thead><tr><th>Class</th><th class="text-end">Payments</th><th class="text-end">Collected</th></tr></thead>
      <tbody><% ((summary && summary.byClass) || []).forEach(function (c) { %><tr>
        <td><span class="badge text-bg-light border"><%= c.className %></span></td>
        <td class="text-end"><%= c.count %></td>
        <td class="text-end fw-semibold">Rs <%= Number(c.total).toLocaleString() %></td>
      </tr><% }) %></tbody>
    </table></div>
  </div></div></div>
</div>

<div class="card shadow-sm mb-4"><div class="card-header"><span class="header-title"><i class="bi bi-cash-coin me-2 text-primary"></i>Record Payment</span></div>
  <div class="card-body">
    <form method="post" action="/payment/save" class="row g-3">
      <div class="col-md-4"><label class="form-label">Student</label><select class="form-select" name="studentId" required><% (students || []).forEach(function (s) { %><option value="<%= s.studentId %>"><%= s.fullName %> (<%= s.className %>)</option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label">Fee Type</label><select class="form-select" name="feeStructureId" required><option value="">-- select fee type --</option><% (feeStructures || []).forEach(function (f) { %><option value="<%= f.feeStructureId %>"><%= f.className %> - <%= f.feeType %> (Rs <%= Number(f.amount).toFixed(2) %>)</option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label">Amount Paid</label><div class="input-group"><span class="input-group-text">Rs</span><input type="number" class="form-control" name="amountPaid" min="0" step="0.01" placeholder="0.00" required></div></div>
      <div class="col-md-4"><label class="form-label">Mode</label><select class="form-select" name="paymentMode"><% (PAYMENT_MODES || []).forEach(function (m) { %><option value="<%= m %>"><%= m %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label">Date</label><input type="date" class="form-control" name="paymentDate" value="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-check2-circle me-1"></i> Save Payment</button></div>
    </form>
  </div>
</div>

<div class="card shadow-sm table-card"><div class="card-header d-flex align-items-center justify-content-between">
    <span class="header-title"><i class="bi bi-list-ul me-2 text-primary"></i>All Payments</span>
    <span class="badge text-bg-primary"><%= (payments || []).length %></span>
  </div>
  <div class="card-body p-0">
    <form method="get" action="/fees/payments" class="p-3 pb-0">
      <select name="studentId" class="form-select" onchange="this.form.submit()">
        <option value="0">All students</option><% (students || []).forEach(function (s) { %><option value="<%= s.studentId %>" <%= Number(studentId) === Number(s.studentId) ? 'selected' : '' %>><%= s.fullName %></option><% }) %>
      </select>
    </form>
    <% if (!payments || !payments.length) { %>
      <div class="empty-state"><i class="bi bi-inbox empty-icon"></i><div class="empty-title">No payments recorded</div><div class="empty-sub">Record your first receipt above.</div></div>
    <% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th>Student</th><th>Class</th><th>Fee Type</th><th class="text-end">Amount</th><th>Mode</th><th>Date</th></tr></thead>
      <tbody><% (payments || []).forEach(function (p) { %><tr>
        <td class="fw-semibold"><i class="bi bi-person-circle me-2 text-muted"></i><%= p.studentName %></td>
        <td><%= p.className || '-' %></td>
        <td><%= p.feeType || '#' + p.feeStructureId %></td>
        <td class="text-end"><strong>Rs <%= Number(p.amountPaid).toFixed(2) %></strong></td>
        <td><span class="badge text-bg-light border"><%= p.paymentMode || '-' %></span></td>
        <td><%= p.paymentDate || '-' %></td>
      </tr><% }) %></tbody>
    </table></div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>