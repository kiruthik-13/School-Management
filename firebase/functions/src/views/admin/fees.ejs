<%- include('../partials/head', { pageTitle: 'Fee Structures', active: 'fees' }) %>
<%- include('../partials/header', { user: user, active: active }) %>
<div class="page-head">
  <div class="page-head-icon" style="background:linear-gradient(135deg,#16a34a,#4ade80)"><i class="bi bi-cash-stack"></i></div>
  <div>
    <h1 class="page-head-title">Fee Structures</h1>
    <p class="page-head-sub">Define what each class pays and when</p>
  </div>
  <div class="page-head-actions">
    <a class="btn btn-outline-secondary" href="/fees/payments"><i class="bi bi-receipt me-1"></i> View Payments</a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-4">
    <div class="card h-100"><div class="card-header"><span class="header-title"><i class="bi bi-plus-circle me-2 text-success"></i>Add Fee Structure</span></div>
      <div class="card-body">
        <form method="post" action="/fee/save" class="row g-3">
          <div class="col-md-6"><label class="form-label">Class</label><select class="form-select" name="className" required><% CLASSES.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }) %></select></div>
          <div class="col-md-6"><label class="form-label">Fee Type</label><input class="form-control" name="feeType" placeholder="Tuition" required></div>
          <div class="col-md-6"><label class="form-label">Amount</label><div class="input-group"><span class="input-group-text">Rs</span><input type="number" class="form-control" name="amount" min="0" step="0.01" placeholder="0.00" required></div></div>
          <div class="col-md-6"><label class="form-label">Due Date</label><input type="date" class="form-control" name="dueDate"></div>
          <div class="col-12"><button class="btn btn-success" type="submit"><i class="bi bi-check-lg me-1"></i> Save Fee</button></div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card shadow-sm table-card h-100"><div class="card-header d-flex align-items-center justify-content-between">
        <span class="header-title"><i class="bi bi-list-ul me-2 text-success"></i>Structures</span>
        <span class="badge text-bg-success"><%= (feeStructures || []).length %></span>
      </div>
      <div class="card-body p-0">
        <form method="get" action="/fees" class="p-3 pb-0">
          <select name="className" class="form-select" onchange="this.form.submit()">
            <option value="">All classes</option><% CLASSES.forEach(function (c) { %><option value="<%= c %>" <%= filterClass === c ? 'selected' : '' %>><%= c %></option><% }) %>
          </select>
        </form>
        <% if (!feeStructures || !feeStructures.length) { %>
          <div class="empty-state"><i class="bi bi-inbox empty-icon"></i><div class="empty-title">No fee structures yet</div><div class="empty-sub">Define one on the left to start collecting fees.</div></div>
        <% } else { %>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead><tr><th>Class</th><th>Fee Type</th><th class="text-end">Amount</th><th>Due Date</th><th class="text-end">Actions</th></tr></thead>
          <tbody><% (feeStructures || []).forEach(function (f) { %><tr>
            <td><span class="badge text-bg-light border"><%= f.className %></span></td>
            <td class="fw-semibold"><%= f.feeType %></td>
            <td class="text-end"><strong>Rs <%= Number(f.amount).toFixed(2) %></strong></td>
            <td><%= f.dueDate || '-' %></td>
            <td class="text-end"><div class="btn-group btn-group-sm">
              <a class="btn btn-outline-secondary" href="/fee/edit?id=<%= f.feeStructureId %>&className=<%= encodeURIComponent(f.className) %>"><i class="bi bi-pencil"></i> Edit</a>
              <a class="btn btn-outline-danger" href="/fee/delete?id=<%= f.feeStructureId %>" data-confirm="Delete the <%= f.feeType %> fee structure for <%= f.className %>?"><i class="bi bi-trash"></i></a>
            </div></td>
          </tr><% }) %></tbody>
        </table></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>