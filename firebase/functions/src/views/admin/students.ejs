<%- include('../partials/head', { pageTitle: 'Students', active: 'students' }) %>
<%- include('../partials/header', { user: user, active: active }) %>
<div class="page-head">
  <div class="page-head-icon"><i class="bi bi-people"></i></div>
  <div>
    <h1 class="page-head-title">Students</h1>
    <p class="page-head-sub">Manage admissions and student records</p>
  </div>
  <div class="page-head-actions">
    <a href="/student/form" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Add Student</a>
  </div>
</div>

<div class="card shadow-sm mb-4"><div class="card-body">
  <div class="toolbar">
    <div class="search-box">
      <i class="bi bi-search"></i>
      <input type="text" class="form-control" data-table-filter="#studentsTable" placeholder="Search name, admission no..." aria-label="Search students">
    </div>
    <form method="get" action="/students" class="d-flex gap-2 ms-auto">
      <select name="className" class="form-select" onchange="this.form.submit()">
        <option value="">All classes</option>
        <% (CLASSES || []).forEach(function (c) { %><option value="<%= c %>" <%= filterClass === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
      <select name="section" class="form-select" onchange="this.form.submit()">
        <option value="">All sections</option>
        <% (SECTIONS || []).forEach(function (sec) { %><option value="<%= sec %>" <%= filterSection === sec ? 'selected' : '' %>><%= sec %></option><% }) %>
      </select>
    </form>
  </div>
</div></div>

<div class="card shadow-sm table-card"><div class="card-body p-0">
  <% if (!students || !students.length) { %>
    <div class="empty-state"><i class="bi bi-inbox empty-icon"></i><div class="empty-title">No students found</div><div class="empty-sub">Try changing the class/section filter or add a new student.</div></div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="studentsTable">
      <thead><tr><th>Admission No</th><th>Name</th><th>Class</th><th>Section</th><th>Parent</th><th class="text-end">Actions</th></tr></thead>
      <tbody><% (students || []).forEach(function (s) { %><tr>
        <td><span class="badge text-bg-light border">#<%= s.admissionNo %></span></td>
        <td class="fw-semibold"><i class="bi bi-person-circle me-2 text-muted"></i><%= s.fullName %></td>
        <td><%= s.className %></td>
        <td><%= s.section || '-' %></td>
        <td><%= s.parentUsername || '<span class="text-muted">—</span>' %></td>
        <td class="text-end"><div class="btn-group btn-group-sm">
          <a class="btn btn-outline-secondary" href="/student/profile?id=<%= s.studentId %>" title="View profile"><i class="bi bi-eye"></i></a>
          <a class="btn btn-outline-primary" href="/student/edit?id=<%= s.studentId %>"><i class="bi bi-pencil"></i> Edit</a>
          <a class="btn btn-outline-danger" href="/student/delete?id=<%= s.studentId %>" data-confirm="Deactivate <%= s.fullName %>? This hides them from active listings."><i class="bi bi-person-x"></i></a>
        </div></td>
      </tr><% }) %></tbody>
    </table>
  </div>
  <% } %>
</div></div>
<%- include('../partials/footer') %>