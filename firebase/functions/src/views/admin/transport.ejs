<%- include('../partials/head', { pageTitle: 'Transport', active: 'transport' }) %>
<%- include('../partials/header', { user: user, active: active }) %>
<div class="page-head">
  <div class="page-head-icon" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)"><i class="bi bi-bus-front"></i></div>
  <div>
    <h1 class="page-head-title">Transport</h1>
    <p class="page-head-sub">Manage bus routes, vehicles and drivers</p>
  </div>
  <div class="page-head-actions">
    <a class="btn btn-outline-secondary" href="/transport/students"><i class="bi bi-people me-1"></i> Student Assignments</a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-4">
    <div class="card h-100"><div class="card-header"><span class="header-title"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Route</span></div>
      <div class="card-body">
        <form method="post" action="/route/save" class="row g-3">
          <div class="col-md-12"><label class="form-label">Route Name</label><input class="form-control" name="routeName" placeholder="e.g. City Centre - School" required autofocus></div>
          <div class="col-md-6"><label class="form-label">Vehicle No</label><input class="form-control" name="vehicleNo" placeholder="TN-01-AB-1234"></div>
          <div class="col-md-6"><label class="form-label">Driver Name</label><input class="form-control" name="driverName"></div>
          <div class="col-md-6"><label class="form-label">Driver Phone</label><input class="form-control" name="driverPhone"></div>
          <div class="col-md-6"><label class="form-label">Fare</label><div class="input-group"><span class="input-group-text">Rs</span><input type="number" class="form-control" name="fare" min="0" step="0.01" placeholder="0.00"></div></div>
          <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i> Save Route</button></div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card shadow-sm table-card h-100"><div class="card-header d-flex align-items-center justify-content-between">
        <span class="header-title"><i class="bi bi-bus-front me-2 text-primary"></i>Routes</span>
        <span class="badge text-bg-primary"><%= (routes || []).length %></span>
      </div>
      <div class="card-body p-0">
        <% if (!routes || !routes.length) { %>
          <div class="empty-state"><i class="bi bi-inbox empty-icon"></i><div class="empty-title">No routes yet</div><div class="empty-sub">Add your first route on the left.</div></div>
        <% } else { %>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead><tr><th>Route</th><th>Vehicle</th><th>Driver</th><th class="text-end">Fare</th></tr></thead>
          <tbody><% (routes || []).forEach(function (r) { %><tr>
            <td class="fw-semibold"><i class="bi bi-signpost-2 me-2 text-muted"></i><%= r.routeName %></td>
            <td><code><%= r.vehicleNo || '-' %></code></td>
            <td><%= r.driverName ? r.driverName + (r.driverPhone ? ' <span class="text-muted">· ' + r.driverPhone + '</span>' : '') : '-' %></td>
            <td class="text-end"><strong>Rs <%= Number(r.fare).toFixed(2) %></strong></td>
          </tr><% }) %></tbody>
        </table></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>