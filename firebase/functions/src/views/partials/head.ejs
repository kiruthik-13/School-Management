<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<script>
  (function(){try{var t=localStorage.getItem('sms-theme')||(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-bs-theme',t);var f=localStorage.getItem('sms-font')||'modern';document.documentElement.setAttribute('data-font',f);var fs=localStorage.getItem('sms-fontsize')||'md';document.documentElement.setAttribute('data-fontsize',fs);}catch(e){}})();
</script>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' - SM' : 'SM' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Chakra+Petch:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="/assets/css/style.css?v=5" rel="stylesheet">
</head>
<body>
<div class="modal fade" id="smsConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Please confirm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body"><p class="mb-0">Are you sure you want to continue?</p></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-confirm-no>Cancel</button>
        <button type="button" class="btn btn-danger" data-confirm-ok>Confirm</button>
      </div>
    </div>
  </div>
</div>
<% var logged = (typeof user !== 'undefined' && user); %>
<div class="app <%= logged ? '' : 'auth-app' %>" id="app">
<% if (logged) { %>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
      SM
    </div>
    <nav class="sidebar-nav">
      <% if (user.role === 'ADMIN') { %>
        <div class="nav-section">Menu</div>
        <a class="side-link <%= active === 'dashboard' ? 'active' : '' %>" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a class="side-link <%= active === 'students' ? 'active' : '' %>" href="/students"><i class="bi bi-people"></i> Students</a>
        <a class="side-link <%= active === 'teachers' ? 'active' : '' %>" href="/teachers"><i class="bi bi-person-video3"></i> Teachers</a>
        <a class="side-link <%= active === 'subjects' ? 'active' : '' %>" href="/subjects"><i class="bi bi-book"></i> Subjects</a>
        <a class="side-link <%= active === 'exams' ? 'active' : '' %>" href="/exams"><i class="bi bi-clipboard-check"></i> Exams</a>
        <a class="side-link <%= active === 'marks' ? 'active' : '' %>" href="/marks"><i class="bi bi-pencil-square"></i> Marks</a>
        <a class="side-link <%= active === 'attendance' ? 'active' : '' %>" href="/attendance"><i class="bi bi-calendar-check"></i> Attendance</a>
        <a class="side-link <%= active === 'fees' ? 'active' : '' %>" href="/fees"><i class="bi bi-cash-stack"></i> Fees</a>
        <a class="side-link <%= active === 'transport' ? 'active' : '' %>" href="/transport"><i class="bi bi-bus-front"></i> Transport</a>
        <a class="side-link <%= active === 'reports' ? 'active' : '' %>" href="/reports"><i class="bi bi-bar-chart"></i> Reports</a>
        <a class="side-link <%= active === 'messages' ? 'active' : '' %>" href="/messages"><i class="bi bi-chat-dots"></i> Messages</a>
        <div class="nav-section">System</div>
        <a class="side-link <%= active === 'users' ? 'active' : '' %>" href="/users"><i class="bi bi-people-gear"></i> Users</a>
      <% } else if (user.role === 'TEACHER') { %>
        <div class="nav-section">Menu</div>
        <a class="side-link <%= active === 'dashboard' ? 'active' : '' %>" href="/teacher"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a class="side-link <%= active === 'marks' ? 'active' : '' %>" href="/marks"><i class="bi bi-pencil-square"></i> Marks</a>
        <a class="side-link <%= active === 'attendance' ? 'active' : '' %>" href="/attendance"><i class="bi bi-calendar-check"></i> Attendance</a>
        <a class="side-link <%= active === 'messages' ? 'active' : '' %>" href="/messages"><i class="bi bi-chat-dots"></i> Messages</a>
      <% } else if (user.role === 'PARENT') { %>
        <div class="nav-section">Menu</div>
        <a class="side-link <%= active === 'dashboard' ? 'active' : '' %>" href="/parent"><i class="bi bi-house"></i> My Dashboard</a>
        <a class="side-link <%= active === 'messages' ? 'active' : '' %>" href="/messages"><i class="bi bi-chat-dots"></i> Messages</a>
      <% } else if (user.role === 'STUDENT') { %>
        <div class="nav-section">Menu</div>
        <a class="side-link <%= active === 'dashboard' ? 'active' : '' %>" href="/student"><i class="bi bi-mortarboard"></i> My Dashboard</a>
      <% } %>
    </nav>
    <div class="sidebar-footer">
      <i class="bi bi-person-circle fs-3"></i>
      <div class="user-chip">
        <div class="user-name"><%= user.username %></div>
        <div class="user-role"><%= user.role === 'ADMIN' ? 'Administrator' : user.role === 'TEACHER' ? 'Teacher' : user.role === 'STUDENT' ? 'Student' : 'Parent' %></div>
      </div>
      <a class="btn btn-sm btn-outline-light text-white-50" href="/logout" title="Logout"><i class="bi bi-box-arrow-right"></i></a>
    </div>
  </aside>
  <div class="app-backdrop" data-sidebar-close></div>
<% } %>
  <div class="app-main">
<% if (logged) { %>
    <header class="topbar">
      <button id="sidebarToggle" class="btn btn-icon d-lg-none" type="button" aria-label="Toggle menu"><i class="bi bi-list"></i></button>
      <h1 class="topbar-title"><%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'SM' %></h1>
      <div class="ms-auto d-flex align-items-center gap-3">
        <div class="topbar-clock" id="topbarClock"><i class="bi bi-clock"></i></div>
        <button id="themeToggle" class="btn btn-icon" type="button" title="Toggle light / dark mode"><i id="themeToggleIcon" class="bi bi-moon-stars"></i></button>
        <a class="btn btn-icon" href="/settings" title="Settings"><i class="bi bi-gear"></i></a>
        <span class="badge text-bg-dark role-badge"><%= user.role %></span>
        <a class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-2" href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </div>
    </header>
<% } %>
    <main class="<%= logged ? 'app-content' : 'auth-shell' %>">
      <% if (!logged) { %>
      <button id="themeToggle" class="btn btn-icon theme-fab" type="button" title="Toggle light / dark mode"><i id="themeToggleIcon" class="bi bi-moon-stars"></i></button>
      <% } %>
      <% if (typeof flashes !== 'undefined' && flashes && flashes.length) { %>
        <script id="pageFlashes" type="application/json"><%- JSON.stringify(flashes).replace(/<\//g, '<\\/') %></script>
      <% } %>