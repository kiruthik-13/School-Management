# =====================================================================
# Firebase / Firestore configuration for the School Management app
# Copy this file to .env and fill in the real values.
# NEVER commit .env - it contains credentials.
# =====================================================================

# Firebase project id (find it in the Firebase console → Project settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to a downloaded service-account JSON key file (recommended).
# In the Firebase console: Project settings → Service accounts → Generate new private key.
# Leave EMPTY when running against the local emulator.
GOOGLE_APPLICATION_CREDENTIALS=

# Local development flag - set to 1 when you only run against the emulator
# so no network calls to real Firebase happen.
FIREBASE_EMULATOR=1

# Session secret - any long random string. Used to sign express sessions.
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional: custom port for a standalone (non-Cloud-Functions) Express run
PORT=5001