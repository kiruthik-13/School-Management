rules_version = '2';

// Development rules: all read/write traffic goes through the Cloud Functions
// backend (the functions runtime uses an admin SDK and is NOT subject to these
// rules). The loose rule below keeps the emulator + direct client access simple
// during development. Lock this down before production.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}