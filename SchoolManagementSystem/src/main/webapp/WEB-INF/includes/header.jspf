<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${pageTitle} - School Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bs-primary: #4f46e5;
            --bs-primary-rgb: 79, 70, 229;
            --bs-secondary: #64748b;
            --bs-secondary-rgb: 100, 116, 139;
            --bs-success: #10b981;
            --bs-success-rgb: 16, 185, 129;
            --bs-info: #0ea5e9;
            --bs-info-rgb: 14, 165, 233;
            --bs-warning: #f59e0b;
            --bs-warning-rgb: 245, 158, 11;
            --bs-danger: #ef4444;
            --bs-danger-rgb: 239, 68, 68;
            --bs-body-font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --bs-link-color: #4f46e5;
            --bs-link-color-rgb: 79, 70, 229;
            --bs-link-hover-color: #4338ca;
            --app-bg: #f4f6fb;
            --app-card-border: #eef1f7;
            --app-title: #111827;
            --topbar-h: 61px;
        }
        body {
            background: var(--app-bg);
            font-family: var(--bs-body-font-family);
            color: #1f2937;
            -webkit-font-smoothing: antialiased;
        }

        /* Topbar */
        .topbar { background: #fff; border-bottom: 1px solid var(--app-card-border); }
        .brand-icon {
            width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
            border-radius: .75rem; background: linear-gradient(135deg, #4f46e5, #7c3aed); color: #fff;
            font-size: 1.2rem; box-shadow: 0 6px 14px -6px rgba(79,70,229,.5);
        }
        .brand-text { color: var(--app-title); line-height: 1.1; }
        .brand-text .sub { color: #6b7280; font-weight: 500; }
        .user-chip {
            background: var(--app-bg); border: 1px solid #e5e7eb; border-radius: 50rem;
            padding: .35rem .85rem; font-size: .875rem; color: #374151;
        }
        .user-chip .role-tag {
            display: inline-block; margin-left: .5rem; background: #e0e7ff; color: #4338ca;
            font-size: .66rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
            padding: .18rem .5rem; border-radius: 50rem;
        }
        .avatar {
            width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;
            border-radius: 50rem; background: linear-gradient(135deg, #4f46e5, #7c3aed); color: #fff; font-size: .8rem; font-weight: 700;
        }
        .logout-btn { border-radius: 50rem; color: #64748b !important; border-color: #e5e7eb; }
        .logout-btn:hover { background: #fef2f2; color: #ef4444 !important; border-color: #fecaca; }

        /* Sidebar */
        .sidebar { min-height: calc(100vh - var(--topbar-h)); background: #fff; border-right: 1px solid var(--app-card-border); }
        .sidebar-label {
            font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: #9ca3af;
            font-weight: 700; margin: .25rem 0 .75rem; padding-left: 1rem;
        }
        .sidebar .nav-link {
            display: flex; align-items: center; gap: .7rem; color: #526071; font-weight: 500;
            font-size: .9rem; padding: .65rem .9rem; border-radius: .65rem; margin-bottom: .1rem;
            transition: all .15s ease;
        }
        .sidebar .nav-link i { font-size: 1.05rem; color: #93a0b4; width: 1.2rem; text-align: center; transition: color .15s ease; }
        .sidebar .nav-link:hover { background: #eef0fd; color: #4f46e5; }
        .sidebar .nav-link:hover i { color: #4f46e5; }
        .sidebar .nav-link.active {
            background: linear-gradient(90deg, #4f46e5, #6366f1); color: #fff;
            box-shadow: 0 8px 16px -8px rgba(79,70,229,.55);
        }
        .sidebar .nav-link.active i { color: #fff; }

        /* Page headings */
        .main-content h4, [class*="col-"].p-4 h4 {
            font-weight: 700; color: var(--app-title); font-size: 1.3rem;
            display: flex; align-items: center; gap: .55rem;
        }
        .main-content h4 i, [class*="col-"].p-4 h4 i {
            color: #4f46e5; background: #eef0fd; padding: .45rem; border-radius: .6rem; font-size: 1.1em;
        }

        /* Cards */
        .card {
            border: 1px solid var(--app-card-border); border-radius: 1rem; background: #fff;
            box-shadow: 0 1px 3px rgba(15,23,42,.05); transition: box-shadow .2s ease, transform .2s ease;
        }
        .card h6 { font-weight: 700; color: var(--app-title); }
        .stat-card { position: relative; overflow: hidden; }
        .stat-card::before {
            content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
            background: linear-gradient(180deg, #4f46e5, #7c3aed);
        }
        .stat-card .text-muted { text-transform: uppercase; letter-spacing: .05em; font-size: .7rem !important; font-weight: 700; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 14px 26px -12px rgba(15,23,42,.18); }

        /* Tables */
        .card .table { --bs-table-bg: transparent; }
        .card .table thead th {
            background: #f8fafc; color: #475569; font-size: .72rem; text-transform: uppercase;
            letter-spacing: .05em; border-bottom: 1px solid #e5e7eb; padding-top: .8rem; padding-bottom: .8rem;
            white-space: nowrap;
        }
        .card .table td { padding-top: .7rem; padding-bottom: .7rem; }
        .card .table-hover tbody tr:hover { background-color: #f6f7fd; }

        /* Badges */
        .badge { padding: .5em .72em; border-radius: 50rem; font-weight: 600; font-size: .74em; }

        /* Buttons */
        .btn { border-radius: .65rem; font-weight: 600; }
        .btn-primary {
            --bs-btn-bg: #4f46e5; --bs-btn-border-color: #4f46e5;
            --bs-btn-hover-bg: #4338ca; --bs-btn-hover-border-color: #4338ca;
            --bs-btn-active-bg: #3730a3; --bs-btn-active-border-color: #3730a3;
        }
        .btn-outline-primary {
            --bs-btn-color: #4f46e5; --bs-btn-border-color: #4f46e5;
            --bs-btn-hover-bg: #4f46e5; --bs-btn-hover-border-color: #4f46e5;
            --bs-btn-active-bg: #3730a3; --bs-btn-active-border-color: #3730a3;
        }

        /* Forms */
        .form-control, .form-select { border-radius: .65rem; border-color: #d6dbe4; }
        .form-control:focus, .form-select:focus {
            border-color: #a5b4fc; box-shadow: 0 0 0 .2rem rgba(79,70,229,.15);
        }
        .form-label { font-weight: 600; color: #374151; font-size: .85rem; }

        /* Alerts */
        .alert { border: 0; border-radius: .8rem; border-left: 4px solid; }
        .alert-success { background: #ecfdf5; color: #065f46; border-left-color: #10b981; }
        .alert-danger { background: #fef2f2; color: #991b1b; border-left-color: #ef4444; }
        .alert-info { background: #ecfeff; color: #0e7490; border-left-color: #06b6d4; }
        .alert-warning { background: #fffbeb; color: #92400e; border-left-color: #f59e0b; }

        /* Footer */
        .app-footer { color: #9ca3af; background: transparent; }
        .app-footer a { color: #4f46e5; text-decoration: none; }

        /* Print */
        @media print {
            .topbar, .sidebar, .btn, .app-footer { display: none !important; }
            body { background: #fff !important; }
            .main-content, [class*="col-"].p-4 { padding: 0 !important; }
            .card { box-shadow: none !important; border: 1px solid #000 !important; }
        }
    </style>
</head>
<body>
<nav class="navbar topbar px-3 py-2 sticky-top">
    <a class="navbar-brand d-flex align-items-center gap-2 me-auto" href="${pageContext.request.contextPath}/index.jsp">
        <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="brand-text">
            <span class="d-block fw-bold">School Management</span>
            <span class="d-none d-sm-block sub">Excellence in Education</span>
        </span>
    </a>
    <div class="d-flex align-items-center gap-2">
        <span class="d-flex align-items-center gap-2">
            <span class="avatar">${fn:substring(user.username, 0, 1)}</span>
            <span class="user-chip">
                <b>${user.username}</b>
                <span class="role-tag">${user.role}</span>
            </span>
        </span>
        <a class="btn btn-sm btn-outline-secondary logout-btn border" href="${pageContext.request.contextPath}/logout">
            <i class="bi bi-box-arrow-right"></i> <span class="d-none d-md-inline">Logout</span>
        </a>
    </div>
</nav>
<div class="container-fluid px-0">
    <div class="row g-0">